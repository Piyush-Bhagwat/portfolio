rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates that the request is authenticated by the authorized site owner
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == "piyushbhagwat5@gmail.com";
    }

    // Site Configuration (profile bio, hero statement, avatar, socials, resume)
    match /site_config/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Skills & Stack (frontend, backend, tools, order, category)
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Experience & Milestones (timeline items, roles, company, period)
    match /experiences/{expId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Projects & Case Studies (title, slug, tech stack, case study Q&A, media)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();

      // Nested case study subcollections if applicable
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Technical Blogs:
    // - Public visitors can read published posts
    // - Admin can read drafts, create new posts, update, and delete
    // - Public visitors can update aggregate metrics (comment_count, rating_count, rating_average) when reviewing
    match /blogs/{blogId} {
      allow read: if (resource != null && resource.data.published == true) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource != null &&
        resource.data.published == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment_count', 'rating_count', 'rating_average', 'updated_at'])
      );
    }

    // Blog Comments & Ratings:
    // - Decoupled collection to handle unbounded scale without bloating blog documents
    // - Public visitors can read visible comments; Admin can read all (including hidden)
    // - Public visitors can submit comments with rating (1-5), author_name (1-50 chars), and optional review content (0-2000 chars)
    // - Only admin can update comments (replies, visibility toggles)
    // - Hard delete is strictly forbidden (allow delete: if false;) to enforce soft deletion
    match /comments/{commentId} {
      allow read: if (resource != null && resource.data.status == "visible") || isAdmin();

      allow create: if request.resource.data.status == "visible" &&
                      request.resource.data.rating is number &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5 &&
                      request.resource.data.author_name is string &&
                      request.resource.data.author_name.size() > 0 &&
                      request.resource.data.author_name.size() <= 50 &&
                      request.resource.data.content is string &&
                      request.resource.data.content.size() <= 2000 &&
                      request.resource.data.post_id is string &&
                      request.resource.data.post_id.size() > 0 &&
                      request.resource.data.admin_reply == null;

      allow update: if isAdmin();

      // Enforce non-destructive soft-delete policy in database rules
      allow delete: if false;
    }
  }
}
